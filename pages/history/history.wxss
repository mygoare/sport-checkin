/* pages/history/history.wxss */
.page {
  min-height: 100vh;
  background: #f0fdf4;
}

/* Header */
.header {
  background: linear-gradient(160deg, #14532d 0%, #15803d 100%);
  padding: 80rpx 40rpx 40rpx;
}

.header-top { margin-bottom: 32rpx; }

.header-title {
  font-size: 52rpx;
  font-weight: 800;
  color: #fff;
  display: block;
}

.header-sub {
  font-size: 26rpx;
  color: rgba(255,255,255,0.45);
  display: block;
  margin-top: 8rpx;
}

/* Stats */
.stats-row {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.1);
  border-radius: 20rpx;
  padding: 28rpx 0;
  margin-bottom: 28rpx;
}

.stat-item { flex: 1; text-align: center; }

.stat-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  display: block;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  display: block;
  margin-top: 6rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255,255,255,0.15);
}

/* Active users */
.active-users {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.active-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
}

.avatar-row { display: flex; align-items: center; }

.active-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255,255,255,0.3);
  margin-left: -16rpx;
}
.active-avatar:first-child { margin-left: 0; }

/* Calendar wrap */
.calendar-wrap {
  background: #fff;
  margin: 24rpx 24rpx 0;
  border-radius: 24rpx;
  padding: 28rpx 20rpx 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(20,83,45,0.08);
}

/* Month navigation */
.month-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.month-label {
  font-size: 32rpx;
  font-weight: 800;
  color: #14532d;
}

.nav-arrow {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f0fdf4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #65a30d;
  font-weight: 300;
  line-height: 1;
}

.arrow-disabled {
  color: #d1d5db;
  background: #f9fafb;
}

.loading-tip {
  text-align: center;
  font-size: 26rpx;
  color: #aaa;
  padding: 40rpx 0;
}

/* Week header */
.week-header {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 12rpx;
}

.week-day {
  text-align: center;
  font-size: 24rpx;
  color: #aaa;
  font-weight: 600;
  padding: 8rpx 0;
}

/* Day grid */
.day-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.day-cell {
  aspect-ratio: 1;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 10rpx;
  position: relative;
  min-height: 90rpx;
}

.cell-empty { background: transparent; }

.cell-active {
  background: #f0fdf4;
}

.cell-today {
  background: #65a30d;
}

.cell-today .day-num { color: #fff; }

.cell-muted { opacity: 0.3; }

.day-num {
  font-size: 26rpx;
  font-weight: 700;
  color: #14532d;
  line-height: 1;
  margin-bottom: 6rpx;
}

/* Avatars in cell */
.day-avatars {
  display: flex;
  align-items: center;
  justify-content: center;
}

.mini-avatar {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #fff;
  box-shadow: 0 1rpx 3rpx rgba(0,0,0,0.15);
}

.overlap { margin-left: -8rpx; }

.more-badge {
  font-size: 14rpx;
  color: #65a30d;
  margin-left: 2rpx;
  font-weight: 700;
}

.empty-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #e5e7eb;
}

/* Legend */
.legend {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #888;
}

.legend-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}

.dot-active { background: #f0fdf4; border: 2rpx solid #65a30d; }
.dot-empty { background: #e5e7eb; }
.dot-today { background: #65a30d; }

/* Detail Popup */
.detail-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.detail-panel {
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  width: 100%;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 36rpx 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.detail-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #14532d;
}

.detail-close {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #888;
}

.detail-list {
  flex: 1;
  overflow: hidden;
  max-height: 50vh;
}

.detail-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 36rpx;
  border-bottom: 1rpx solid #f9f9f9;
}

.detail-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 3rpx solid #dcfce7;
}

.detail-body { flex: 1; margin-left: 20rpx; }

.detail-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.detail-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #14532d;
}

.detail-time { font-size: 22rpx; color: #bbb; }

.detail-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.5;
}

.detail-footer {
  text-align: center;
  padding: 24rpx;
  font-size: 30rpx;
  color: #65a30d;
  font-weight: 600;
  border-top: 1rpx solid #f5f5f5;
}
