<!-- pages/history/history.wxml -->
<view class="page">

  <!-- Header -->
  <view class="header">
    <view class="header-top">
      <text class="header-title">打卡动态</text>
      <text class="header-sub">{{currentMonthLabel}}打卡记录</text>
    </view>

    <!-- Stats Row -->
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-num">{{totalCheckins}}</text>
        <text class="stat-label">总打卡次数</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num">{{activeUsers.length}}</text>
        <text class="stat-label">参与人数</text>
      </view>
    </view>

    <!-- Active user avatars -->
    <view class="active-users" wx:if="{{activeUsers.length > 0}}">
      <text class="active-label">活跃成员</text>
      <view class="avatar-row">
        <image
          class="active-avatar"
          wx:for="{{activeUsers}}"
          wx:key="userId"
          src="{{item.avatarUrl}}"
          mode="aspectFill"
        ></image>
      </view>
    </view>
  </view>

  <!-- Calendar -->
  <block wx:if="{{showHistoryCalendar}}">
    <view class="calendar-wrap">

      <!-- Month navigation -->
      <view class="month-nav">
        <view class="nav-arrow {{canPrev ? '' : 'arrow-disabled'}}" bindtap="onPrevMonth">‹</view>
        <text class="month-label">{{currentMonthLabel}}</text>
        <view class="nav-arrow {{canNext ? '' : 'arrow-disabled'}}" bindtap="onNextMonth">›</view>
      </view>

      <!-- Loading -->
      <view wx:if="{{loading}}" class="loading-tip">加载中...</view>

      <!-- Week header -->
      <view class="week-header">
        <view class="week-day" wx:for="{{weekDays}}" wx:key="*this">{{item}}</view>
      </view>

      <!-- Day grid -->
      <view class="day-grid">
        <block wx:for="{{calendarDays}}" wx:key="index">

          <!-- Empty cell (padding) -->
          <view wx:if="{{item.empty}}" class="day-cell cell-empty"></view>

          <!-- Day cell -->
          <view
            wx:else
            class="day-cell {{item.isToday ? 'cell-today' : ''}} {{item.hasCheckin && !item.isToday ? 'cell-active' : ''}} {{item.isFuture ? 'cell-muted' : ''}}"
            bindtap="onDayTap"
            data-date-str="{{item.dateStr}}"
            data-has-checkin="{{item.hasCheckin}}"
          >
            <text class="day-num">{{item.dayNum}}</text>

            <!-- Avatars -->
            <view class="day-avatars" wx:if="{{item.users.length > 0}}">
              <image
                class="mini-avatar {{userIndex > 0 ? 'overlap' : ''}}"
                wx:for="{{item.users}}"
                wx:for-item="user"
                wx:for-index="userIndex"
                wx:key="userId"
                wx:if="{{userIndex < 2}}"
                src="{{user.avatarUrl}}"
                mode="aspectFill"
              ></image>
              <view class="more-badge" wx:if="{{item.users.length > 2}}">+{{item.users.length - 2}}</view>
            </view>

            <!-- Check dot -->
            <view wx:elif="{{!item.isFuture}}" class="empty-dot"></view>
          </view>

        </block>
      </view>

      <!-- Legend -->
      <view class="legend">
        <view class="legend-item">
          <view class="legend-dot dot-active"></view>
          <text>有打卡</text>
        </view>
        <view class="legend-item">
          <view class="legend-dot dot-empty"></view>
          <text>未打卡</text>
        </view>
        <view class="legend-item">
          <view class="legend-dot dot-today"></view>
          <text>今天</text>
        </view>
      </view>
    </view>
  </block>

  <!-- Detail Popup -->
  <view class="detail-mask" wx:if="{{showDetail}}" bindtap="onCloseDetail">
    <view class="detail-panel" catchtap="">
      <view class="detail-header">
        <text class="detail-title">{{selectedDateLabel}} 打卡记录</text>
        <view class="detail-close" bindtap="onCloseDetail">✕</view>
      </view>

      <scroll-view class="detail-list" scroll-y>
        <view class="detail-item" wx:for="{{selectedCheckins}}" wx:key="timestamp">
          <image class="detail-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
          <view class="detail-body">
            <view class="detail-row">
              <text class="detail-name">{{item.nickName}}</text>
              <text class="detail-time">{{item.time}}</text>
            </view>
            <view class="detail-content">{{item.content}}</view>
          </view>
        </view>
      </scroll-view>

      <view class="detail-footer" bindtap="onCloseDetail">关闭</view>
    </view>
  </view>

</view>
