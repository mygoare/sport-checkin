/* pages/index/index.wxss */
.container {
  min-height: 100vh;
  background: #f0fdf4;
  padding-bottom: 40rpx;
}

/* Header */
.header {
  position: relative;
  background: linear-gradient(135deg, #14532d 0%, #166534 50%, #15803d 100%);
  padding: 80rpx 40rpx 60rpx;
  overflow: hidden;
}

.header-content {
  position: relative;
  z-index: 2;
}

.date-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.55);
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.header-title {
  font-size: 52rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.header-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.45);
  margin-top: 12rpx;
}

.deco-circle {
  position: absolute;
  border-radius: 50%;
  border: 2rpx solid rgba(255,255,255,0.08);
}
.deco-1 { width: 300rpx; height: 300rpx; right: -80rpx; top: -80rpx; }
.deco-2 { width: 180rpx; height: 180rpx; right: 80rpx; top: 60rpx; background: rgba(101,163,13,0.15); }
.deco-3 { width: 100rpx; height: 100rpx; right: 200rpx; top: 20rpx; }

/* User Card */
.user-card {
  background: #fff;
  border-radius: 24rpx;
  margin: -30rpx 28rpx 0;
  padding: 36rpx;
  box-shadow: 0 8rpx 40rpx rgba(20,83,45,0.12);
  position: relative;
  z-index: 3;
}

.user-info-row {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid #dcfce7;
  flex-shrink: 0;
}

.user-meta {
  flex: 1;
  margin-left: 24rpx;
}

.user-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #14532d;
  margin-bottom: 8rpx;
}

.user-status {
  font-size: 26rpx;
  font-weight: 500;
}

.status-done { color: #10b981; }
.status-pending { color: #f59e0b; }

.streak-badge {
  font-size: 48rpx;
}

.checkin-btn {
  border-radius: 100rpx;
  padding: 28rpx 0;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.btn-active {
  background: linear-gradient(135deg, #65a30d, #84cc16);
  color: #fff;
  box-shadow: 0 8rpx 28rpx rgba(101,163,13,0.4);
}

.btn-done {
  background: #f0fdf4;
  color: #10b981;
}

/* Login Prompt */
.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.login-icon { font-size: 72rpx; margin-bottom: 16rpx; }

.login-text {
  font-size: 28rpx;
  color: #888;
  margin-bottom: 28rpx;
}

.login-btn {
  background: linear-gradient(135deg, #65a30d, #84cc16) !important;
  color: #fff !important;
  border-radius: 100rpx !important;
  font-size: 30rpx !important;
  font-weight: 600 !important;
  padding: 0 60rpx !important;
  height: 80rpx !important;
  line-height: 80rpx !important;
  border: none !important;
  box-shadow: 0 8rpx 24rpx rgba(101,163,13,0.35) !important;
}

/* Section */
.section {
  margin: 32rpx 28rpx 0;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #14532d;
}

.section-count {
  font-size: 24rpx;
  color: #65a30d;
  background: #dcfce7;
  padding: 6rpx 18rpx;
  border-radius: 100rpx;
}

/* Empty state */
.empty-state {
  background: #fff;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  text-align: center;
}

.empty-icon { font-size: 72rpx; display: block; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; color: #aaa; }

/* Checkin List */
.checkin-list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.checkin-item {
  display: flex;
  align-items: flex-start;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.checkin-item:last-child { border-bottom: none; }

.item-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 2rpx solid #dcfce7;
}

.item-body {
  flex: 1;
  margin-left: 20rpx;
}

.item-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #14532d;
}

.item-time {
  font-size: 22rpx;
  color: #bbb;
}

.item-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.5;
}

/* Preset hint */
.preset-hint {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin: 28rpx 28rpx 0;
  flex-wrap: wrap;
}

.preset-hint text {
  background: #fff;
  border-radius: 100rpx;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: #666;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

/* History link */
.history-link {
  text-align: center;
  font-size: 28rpx;
  color: #65a30d;
  font-weight: 500;
  margin-top: 32rpx;
  padding: 20rpx;
}

/* ── Profile Setup ── */
.setup-prompt {
  padding: 8rpx 0 20rpx;
}

.setup-welcome {
  text-align: center;
  margin-bottom: 40rpx;
}

.setup-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #14532d;
  margin-bottom: 10rpx;
}

.setup-subtitle {
  display: block;
  font-size: 26rpx;
  color: #888;
}

/* Step indicator */
.setup-steps {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 36rpx;
  padding: 0 10rpx;
}

.setup-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.step-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  transition: all 0.3s;
}

.step-label {
  font-size: 20rpx;
  white-space: nowrap;
}

.step-line {
  flex: 1;
  height: 2rpx;
  background: #e5e7eb;
  margin: 0 8rpx;
  margin-bottom: 24rpx;
}

.step-active .step-dot {
  background: linear-gradient(135deg, #65a30d, #84cc16);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(101,163,13,0.35);
}
.step-active .step-label { color: #65a30d; font-weight: 600; }

.step-done .step-dot {
  background: #10b981;
  color: #fff;
}
.step-done .step-label { color: #10b981; font-weight: 600; }

.step-idle .step-dot {
  background: #f3f4f6;
  color: #bbb;
}
.step-idle .step-label { color: #ccc; }

/* Avatar */
.setup-avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 36rpx;
}

.avatar-picker-btn {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  padding: 0;
  background: transparent;
  border: none;
  box-shadow: none;
  margin-bottom: 16rpx;
}

.avatar-picker-btn::after { border: none; }

.setup-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
}

.avatar-set {
  border: 6rpx solid #65a30d;
  box-shadow: 0 8rpx 24rpx rgba(101,163,13,0.25);
}

.avatar-empty {
  background: linear-gradient(135deg, #f0fdf4, #dcfce7);
  border: 4rpx dashed #86efac;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.avatar-empty-icon { font-size: 52rpx; line-height: 1; }
.avatar-empty-hint { font-size: 18rpx; color: #4ade80; }

.avatar-edit-badge {
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  width: 44rpx;
  height: 44rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.15);
}

.avatar-hint-text { font-size: 24rpx; }
.hint-done { color: #10b981; font-weight: 600; }
.hint-pending { color: #aaa; }

/* Nickname */
.nickname-wrap {
  margin-bottom: 36rpx;
}

.nickname-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 12rpx;
}

.nickname-input-box {
  display: flex;
  align-items: center;
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  transition: border-color 0.2s;
}

.input-filled {
  border-color: #65a30d;
  background: #f0fdf4;
}

.nickname-icon { font-size: 28rpx; margin-right: 16rpx; }

.nickname-input {
  flex: 1;
  font-size: 30rpx;
  color: #14532d;
  height: 44rpx;
  line-height: 44rpx;
}

.nickname-placeholder { color: #d1d5db; }

.nickname-count {
  font-size: 20rpx;
  color: #d1d5db;
  margin-left: 12rpx;
}

/* Save button */
.save-btn {
  border-radius: 100rpx;
  padding: 30rpx 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  transition: opacity 0.2s;
}

.save-btn-active {
  background: linear-gradient(135deg, #65a30d, #84cc16);
  color: #fff;
  box-shadow: 0 10rpx 30rpx rgba(101,163,13,0.4);
}

.save-btn-disabled {
  background: #f3f4f6;
  color: #ccc;
}

.setup-tip {
  text-align: center;
  font-size: 22rpx;
  color: #d1d5db;
  line-height: 1.6;
}

/* Join button */
.join-btn {
  margin-top: 32rpx;
  padding: 28rpx 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #65a30d;
  background: #f0fdf4;
  border-radius: 100rpx;
  border: 2rpx dashed #86efac;
}

/* Setup card */
.setup-card {
  background: #fff;
  border-radius: 24rpx;
  margin: 24rpx 0 0;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(20,83,45,0.08);
}