/* app.wxss - Global Styles */
page {
  background: #f0f4ff;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: #1a1a2e;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin: 24rpx 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(79, 70, 229, 0.08);
}

.btn-primary {
  background: linear-gradient(135deg, #4f46e5, #7c3aed);
  color: #fff;
  border-radius: 100rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 24rpx rgba(79, 70, 229, 0.35);
}

.btn-secondary {
  background: #f0f4ff;
  color: #4f46e5;
  border-radius: 100rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
}

.section-title {
  font-size: 28rpx;
  color: #888;
  font-weight: 500;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  margin-bottom: 16rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  background: #ede9fe;
  color: #4f46e5;
  border-radius: 100rpx;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}
